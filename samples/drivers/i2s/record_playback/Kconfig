source "Kconfig.zephyr"

config SAMPLE_FREQ
	int "Sample rate in Hz"
	default 16000
	help
	  Sample frequency of the recorded/replayed audio. Higher rates
	  increase the RAM usage of the record buffer proportionally.

config RECORD_SECONDS
	int "Duration in seconds of the record/replay cycle"
	default 5
	help
	  Amount of audio, in seconds, recorded before being replayed. The
	  whole recording is kept in RAM, so increasing this value increases
	  RAM usage proportionally.

config USE_CODEC_CLOCK
	bool "I2S BCK/WS are generated by the audio codec"
	help
	  If selected, the I2S peripheral will be configured to consume
	  (receive) the I2S BCK and WS signals and the codec will be
	  configured to generate those. If not selected (default), the I2S
	  peripheral will generate them and the codec will be expected to
	  consume them.
